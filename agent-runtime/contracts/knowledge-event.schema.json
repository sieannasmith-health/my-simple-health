{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysimplehealth.com/schemas/agent-os/knowledge-event.schema.json",
  "title": "MSH Agent OS Knowledge Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "actor", "subject", "provenance"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["objective.created", "objective.updated", "assignment.changed", "handoff.executed", "decision.recorded", "artifact.created", "pr.created", "pr.merged", "test.completed", "qa.completed", "deployment.completed", "blocker.recorded", "human_gate.requested", "objective.completed"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["objective", "agent", "decision", "artifact", "pull_request", "test", "deployment", "blocker", "human_gate"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "objective_id": {"type": ["string", "null"]},
    "from_agent": {"type": ["string", "null"]},
    "to_agent": {"type": ["string", "null"]},
    "relation": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_id"],
      "properties": {
        "source": {"enum": ["github", "agent_runtime", "ci", "qa", "deployment", "founder", "external"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"]},
        "commit_sha": {"type": ["string", "null"]}
      }
    },
    "correlation_id": {"type": ["string", "null"]},
    "causation_id": {"type": ["string", "null"]}
  }
}
