{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysimplehealth.com/schemas/agent-os/knowledge-graph.schema.json",
  "title": "MSH Agent OS Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges", "generated_at"],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "provenance"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["objective", "agent", "decision", "artifact", "pull_request", "test", "deployment", "blocker", "human_gate", "evidence"]},
          "label": {"type": "string"},
          "status": {"type": ["string", "null"]},
          "properties": {"type": "object"},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type", "provenance"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"enum": ["OWNS", "ASSIGNED_TO", "DEPENDS_ON", "IMPLEMENTS", "VALIDATED_BY", "PRODUCED", "SUPPORTED_BY", "BLOCKED_BY", "SUPERSEDES", "HANDED_OFF_TO", "DEPLOYED_AS", "REQUIRES"]},
          "properties": {"type": "object"},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
