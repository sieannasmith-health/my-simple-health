{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysimplehealth.com/schemas/agent-os/objective.schema.json",
  "title": "MSH Agent OS Objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intent", "owner", "status", "acceptance", "authority", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "EXECUTING", "PAUSED_FOR_SIEA", "BLOCKED", "COMPLETED", "FAILED", "CANCELED"]},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string"}, "default": []},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granted_by", "scope"],
      "properties": {
        "granted_by": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "items": {"type": "string"}},
        "requires_human_for": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "current_stage": {"type": ["string", "null"]},
    "assigned_agent": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "artifacts": {"type": "array", "items": {"type": "string"}, "default": []},
    "evidence": {"type": "array", "items": {"type": "string"}, "default": []},
    "decisions": {"type": "array", "items": {"type": "string"}, "default": []},
    "attempts": {"type": "integer", "minimum": 0, "default": 0},
    "hop_count": {"type": "integer", "minimum": 0, "default": 0},
    "max_hops": {"type": "integer", "minimum": 1, "default": 24},
    "human_gate": {"type": ["object", "null"]},
    "completion_evidence": {"type": "array", "items": {"type": "string"}, "default": []},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
