# Optional comma-separated browser origins allowed to call /api/hello.
# Use complete origins only, without paths (for example: https://staging.example.com).
HELLO_ALLOWED_ORIGINS=

# Upstash Redis REST credentials for the server-only Hello rate limiter.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Generate a strong random value and configure it only in the deployment environment.
HELLO_RATE_LIMIT_SECRET=

# Optional positive-integer overrides. Defaults: 20 normal requests,
# 5 research requests, and a 600-second fixed window.
HELLO_RATE_LIMIT_NORMAL_MAX=20
HELLO_RATE_LIMIT_RESEARCH_MAX=5
HELLO_RATE_LIMIT_WINDOW_SECONDS=600

# VERCEL_URL, VERCEL_BRANCH_URL, and VERCEL_PROJECT_PRODUCTION_URL are
# system variables. Expose Vercel System Environment Variables to deployments;
# do not copy deployment URLs into this file.
