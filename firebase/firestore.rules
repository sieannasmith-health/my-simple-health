rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : "";
    }

    function relationshipPath(id) {
      return /databases/$(database)/documents/sharingRelationships/$(id);
    }

    function grantPath(id) {
      return /databases/$(database)/documents/sharingGrants/$(id);
    }

    function isRelationshipParticipant(data) {
      return signedIn() && (
        data.inviterID == request.auth.uid ||
        data.inviteeID == request.auth.uid ||
        data.inviteeEmail == email()
      );
    }

    function acceptedRelationshipForGrant(data) {
      let relationship = get(relationshipPath(data.relationshipID));
      return relationship.data.status == "accepted" &&
        (
          (relationship.data.inviterID == data.ownerID && relationship.data.inviteeID == data.recipientID) ||
          (relationship.data.inviteeID == data.ownerID && relationship.data.inviterID == data.recipientID)
        );
    }

    function ownsCoreMemberNamespace(userID) {
      return signedIn() && request.auth.uid == userID;
    }

    function validCoreProvenance(value) {
      return value in ["USER_STATED", "USER_CONFIRMED", "SYSTEM_OBSERVED", "MODEL_INFERRED"];
    }

    function validCoreAuthority(value) {
      return value in ["member", "external_source", "system_derived", "model_inference"];
    }

    function validCoreLifecycle(value) {
      return value in ["ACTIVE", "AMENDED", "SUPERSEDED", "DELETED"];
    }

    function validCoreDomain(value) {
      return value in [
        "onboarding", "landscape", "focus", "vision", "project",
        "practice", "reflection", "learning", "progress", "return_point"
      ];
    }

    function validCoreRecord(data, userID, recordID) {
      return data.keys().hasAll([
          "recordID", "ownerID", "domain", "recordType", "schemaVersion",
          "provenance", "authority", "lifecycleStatus", "sourceRecordIDs",
          "createdAt", "updatedAt"
        ])
        && data.recordID == recordID
        && data.ownerID == userID
        && data.recordID is string
        && data.recordType is string
        && data.schemaVersion == "1.0.0"
        && validCoreDomain(data.domain)
        && validCoreProvenance(data.provenance)
        && validCoreAuthority(data.authority)
        && validCoreLifecycle(data.lifecycleStatus)
        && data.sourceRecordIDs is list
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(["deletedAt"]) || data.deletedAt == null || data.deletedAt is timestamp);
    }

    function immutableCoreIdentityPreserved() {
      return request.resource.data.recordID == resource.data.recordID
        && request.resource.data.ownerID == resource.data.ownerID
        && request.resource.data.domain == resource.data.domain
        && request.resource.data.recordType == resource.data.recordType
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.provenance == resource.data.provenance
        && request.resource.data.authority == resource.data.authority
        && request.resource.data.sourceRecordIDs == resource.data.sourceRecordIDs
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /sharingRelationships/{relationshipID} {
      allow create: if signedIn()
        && request.resource.data.inviterID == request.auth.uid
        && request.resource.data.inviterEmail == email()
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail != email()
        && request.resource.data.status == "pending"
        && request.resource.data.inviteeID == null;

      allow read: if isRelationshipParticipant(resource.data);

      allow update: if signedIn() && (
        (
          resource.data.status == "pending"
          && resource.data.inviteeEmail == email()
          && request.auth.token.email_verified == true
          && request.resource.data.inviteeID == request.auth.uid
          && request.resource.data.status == "accepted"
          && request.resource.data.inviterID == resource.data.inviterID
          && request.resource.data.inviterEmail == resource.data.inviterEmail
          && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        )
        ||
        (
          (resource.data.inviterID == request.auth.uid || resource.data.inviteeID == request.auth.uid)
          && request.resource.data.status == "revoked"
          && request.resource.data.inviterID == resource.data.inviterID
          && request.resource.data.inviteeID == resource.data.inviteeID
          && request.resource.data.inviterEmail == resource.data.inviterEmail
          && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        )
      );

      allow delete: if false;
    }

    match /sharingGrants/{grantID} {
      allow create: if signedIn()
        && request.resource.data.ownerID == request.auth.uid
        && request.resource.data.recipientID is string
        && request.resource.data.relationshipID is string
        && request.resource.data.category in ["calendar", "workouts", "finances", "health"]
        && request.resource.data.permission in ["view", "collaborate"]
        && (request.resource.data.category != "health" || request.resource.data.permission == "view")
        && acceptedRelationshipForGrant(request.resource.data);

      allow read: if signedIn()
        && (resource.data.ownerID == request.auth.uid || resource.data.recipientID == request.auth.uid);

      allow update: if signedIn()
        && resource.data.ownerID == request.auth.uid
        && request.resource.data.ownerID == resource.data.ownerID
        && request.resource.data.recipientID == resource.data.recipientID
        && request.resource.data.relationshipID == resource.data.relationshipID
        && request.resource.data.category == resource.data.category
        && (request.resource.data.category != "health" || request.resource.data.permission == "view")
        && acceptedRelationshipForGrant(request.resource.data);

      allow delete: if false;
    }

    match /sharedItems/{itemID} {
      allow create, update: if signedIn()
        && request.resource.data.ownerID == request.auth.uid
        && request.resource.data.grantID is string
        && request.resource.data.recipientID is string
        && request.resource.data.resourceType in [
          "calendar_event",
          "workout_video",
          "workout_collection",
          "financial_item",
          "health_metric_summary"
        ]
        && exists(grantPath(request.resource.data.grantID))
        && get(grantPath(request.resource.data.grantID)).data.ownerID == request.auth.uid
        && get(grantPath(request.resource.data.grantID)).data.recipientID == request.resource.data.recipientID
        && get(grantPath(request.resource.data.grantID)).data.isActive == true
        && (
          request.resource.data.resourceType != "health_metric_summary"
          || (
            get(grantPath(request.resource.data.grantID)).data.category == "health"
            && get(grantPath(request.resource.data.grantID)).data.permission == "view"
          )
        );

      allow read: if signedIn()
        && (resource.data.ownerID == request.auth.uid || resource.data.recipientID == request.auth.uid);

      allow delete: if signedIn() && resource.data.ownerID == request.auth.uid;
    }

    // Core-v1 account-backed authority foundation. No journey domain is migrated in B.1.
    // Every record lives under its Firebase Auth UID and carries a stable authority envelope.
    match /users/{userID}/coreRecords/{recordID} {
      allow read: if ownsCoreMemberNamespace(userID);

      allow create: if ownsCoreMemberNamespace(userID)
        && validCoreRecord(request.resource.data, userID, recordID);

      allow update: if ownsCoreMemberNamespace(userID)
        && validCoreRecord(request.resource.data, userID, recordID)
        && immutableCoreIdentityPreserved();

      // Domain deletion is represented through lifecycle/tombstone semantics so lineage survives.
      allow delete: if false;
    }

    // Plaid access tokens and sync cursors are backend-only. Firebase Admin SDK
    // bypasses these client rules; no iOS/Web client can directly read or write them.
    match /mshServerPlaidItems/{itemID} {
      allow read, write: if false;
    }

    // Sanitized Plaid views are private to the person who created the connection.
    // Household sharing must flow through MSH's explicit sharing layer above.
    match /users/{userID}/plaidConnections/{connectionID} {
      allow read: if signedIn() && request.auth.uid == userID;
      allow write: if false;
    }

    match /users/{userID}/plaidAccounts/{accountID} {
      allow read: if signedIn() && request.auth.uid == userID;
      allow write: if false;
    }

    match /users/{userID}/plaidTransactions/{transactionID} {
      allow read: if signedIn() && request.auth.uid == userID;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
